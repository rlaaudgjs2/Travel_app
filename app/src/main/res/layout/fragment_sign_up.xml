<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignIn">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />


<TextView
    android:id="@+id/signupEmail"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="아이디 (이메일)"
    android:textStyle="bold"
    android:textColor="@color/black"
    android:layout_marginTop="20dp"
    app:layout_constraintTop_toBottomOf="@+id/signUpToolbar"
    app:layout_constraintLeft_toLeftOf="@+id/signUpToolbar"/>

    <EditText
        android:id="@+id/sign_id"
        android:layout_width="335dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/border"
        android:drawableLeft="@drawable/login"
        android:drawablePadding="10dp"
        android:hint="아이디를입력하세요"
        android:paddingLeft="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintLeft_toLeftOf="@+id/signupEmail"
        app:layout_constraintTop_toBottomOf="@+id/signupEmail"
        />
    <TextView
        android:id="@+id/signupPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_id"

        app:layout_constraintLeft_toLeftOf="@+id/signUpToolbar"/>

    <EditText
        android:id="@+id/sign_password"
        android:layout_width="335dp"
        android:layout_height="48dp"
        android:background="@drawable/border"
        android:drawableLeft="@drawable/password"
        android:drawablePadding="10dp"
        android:layout_marginStart="20dp"
        android:ems="10"
        android:layout_marginTop="10dp"
        android:hint="비밀번호를 입력하세요"
        android:inputType="textPassword"
        android:paddingLeft="10dp"
        app:layout_constraintLeft_toLeftOf="@+id/signupPassword"
        app:layout_constraintTop_toBottomOf="@+id/signupPassword"
        />
    <TextView
        android:id="@+id/signupNickmane"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="닉네임"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/sign_password"
        app:layout_constraintLeft_toLeftOf="@+id/signUpToolbar"/>

    <EditText
        android:id="@+id/nickName"
        android:layout_width="227dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_goneMarginTop="10dp"
        android:background="@drawable/border"
        android:drawableLeft="@drawable/login"
        android:drawablePadding="10dp"
        android:hint="닉네임을 입력하세요"
        android:paddingLeft="10dp"
        app:layout_constraintLeft_toLeftOf="@+id/signupNickmane"
        app:layout_constraintTop_toBottomOf="@+id/signupNickmane"
       />
    <android.widget.Button
        android:id="@+id/signUp_commit"
        android:layout_width="343dp"
        android:layout_height="48dp"
        android:background="@drawable/blackbutton"
        android:text="회원가입"
        android:textSize="14dp"
        android:layout_marginBottom="20dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />
    <android.widget.Button
        android:id="@+id/checkNick"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:background="@color/blue"
        android:text="중복확인"
        android:textColor="@color/white"
        android:layout_marginStart="10dp"
        app:layout_constraintLeft_toRightOf="@+id/nickName"
        app:layout_constraintTop_toTopOf="@id/nickName"/>
       <Toolbar
        android:id="@+id/signUpToolbar"
        android:layout_width="375dp"
        android:layout_height="57dp"
        android:title="회원가입"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:titleTextColor="@color/black"
        android:titleMarginStart="150dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>