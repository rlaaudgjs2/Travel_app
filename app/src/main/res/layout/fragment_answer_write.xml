<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_backspace_answer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_backspace"
            android:contentDescription="뒤로가기" />

        <!-- TextView for centered title -->
        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="질문하기"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black" />
    </androidx.appcompat.widget.Toolbar>
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="제목"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        />

    <!-- 제목 입력 -->
    <EditText
        android:id="@+id/edt_title_question"
        android:layout_width="343dp"
        android:layout_height="48dp"
        android:hint="제목을 입력해주세요"
        android:padding="12dp"
        android:background="@drawable/rounded_edittext"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintLeft_toLeftOf="@id/titleText"
         />
    <TextView
        android:id="@+id/textRegion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="지역"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="@id/edt_title_question"
        app:layout_constraintTop_toBottomOf="@id/edt_title_question"
        />
    <!-- 지역 선택 -->
    <Spinner
        android:id="@+id/spinner_region"
        android:layout_width="343dp"
        android:layout_height="48dp"
        android:background="@drawable/rounded_spinner"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/textRegion"
        app:layout_constraintLeft_toLeftOf="@id/textRegion" />
    <TextView
        android:id="@+id/textAnswer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="질문내용"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="@id/spinner_region"
        app:layout_constraintTop_toBottomOf="@id/spinner_region"
        />
    <!-- 질문 내용 -->
    <EditText
        android:id="@+id/edt_write_answer"
        android:layout_width="343dp"
        android:layout_height="192dp"
        android:hint="질문 내용을 자세히 작성해주세요"
        android:background="@drawable/rounded_edittext"
        android:gravity="top|start"
        android:layout_marginTop="10dp"
        android:padding="12dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/textAnswer"
        app:layout_constraintStart_toStartOf="@id/textAnswer"
      />
    <ImageButton
        android:id="@+id/btnAddImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/imageadd"
        app:layout_constraintTop_toBottomOf="@id/edt_write_answer"
        app:layout_constraintLeft_toLeftOf="@id/edt_write_answer"/>
    <!-- 사진 첨부 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_photos"
        android:layout_width="243dp"
        android:layout_height="80dp"
        android:overScrollMode="never"
        android:padding="8dp"
        android:layout_marginLeft="10dp"
        app:layout_constraintLeft_toRightOf="@+id/btnAddImage"
        app:layout_constraintTop_toTopOf="@+id/btnAddImage"
        android:clipToPadding="false"
        android:scrollbars="horizontal" />
    <!-- 등록 버튼 -->
    <Button
        android:id="@+id/btn_register_answer"
        android:layout_width="343dp"
        android:layout_height="48dp"
        android:text="작성완료"
        android:background="@drawable/blackbutton"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
