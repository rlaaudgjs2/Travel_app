<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WriteBulletinFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp">

        <!-- Toolbar Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_backspace_answer"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_backspace"
                android:contentDescription="뒤로가기 버튼"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/txt_title"
                android:layout_margin="16dp" />

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="질문하기"
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_backspace_answer"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="16dp"
                android:gravity="center" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Input Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="제목"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edt_title_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="제목을 입력해주세요"
                android:background="@drawable/bg_edittext"
                android:padding="12dp" />

            <!-- Region Dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지역"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_region"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext" />

            <!-- Question Content Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="질문 내용"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edt_write_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="질문 내용을 입력해주세요"
                android:background="@drawable/bg_edittext"
                android:padding="12dp"
                android:minHeight="150dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_register_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="작성완료"
            android:backgroundTint="@android:color/black"
            android:textColor="@android:color/white"
            android:layout_marginTop="16dp"
            android:layout_gravity="center" />
    </LinearLayout>
</FrameLayout>
